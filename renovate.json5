{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>rmednitzer/infra:renovate-preset"],
  "pre-commit": { "enabled": true },
  "packageRules": [
    {
      "description": "Group pre-commit hook updates into one PR.",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Group non-major Ansible Galaxy collection and role requirement updates.",
      "matchManagers": ["ansible-galaxy"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "ansible galaxy requirements"
    }
  ]
}
