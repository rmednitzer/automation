# {{ ansible_managed }}
# USBGuard daemon configuration (roles/usbguard). POL-001 (default-deny USB).
RuleFile={{ usbguard_rules_file }}
{% if usbguard_rules_folder | length > 0 %}
RuleFolder={{ usbguard_rules_folder }}
{% endif %}
ImplicitPolicyTarget={{ usbguard_implicit_policy_target }}
PresentDevicePolicy={{ usbguard_present_device_policy }}
# Never deauthorise USB controllers on start (that would blackout all USB).
PresentControllerPolicy=keep
InsertedDevicePolicy={{ usbguard_inserted_device_policy }}
RestoreControllerDeviceState=false
DeviceManagerBackend=uevent
IPCAllowedUsers=root
IPCAllowedGroups=root
IPCAccessControlFiles=/etc/usbguard/IPCAccessControl.d/
DeviceRulesWithPort=false
AuditBackend=FileAudit
AuditFilePath=/var/log/usbguard/usbguard-audit.log
HidePII=false
