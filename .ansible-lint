---
profile: production

exclude_paths:
  - .git/
  - .github/
  - collections/
  - .venv/
  - venv/
  # ansible-vault-encrypted secrets files are named `vault.yml` (CLAUDE.md
  # "Secrets management"); their ciphertext is not parseable YAML. The
  # plaintext `vault.yml.example` templates keep being linted.
  - inventories/development/group_vars/vault.yml
  - inventories/production/group_vars/vault.yml
  - inventories/staging/group_vars/vault.yml

skip_list:
  - yaml[line-length]
  - var-naming[no-role-prefix]

enable_list:
  - fqcn
  - no-changed-when

warn_list:
  - experimental

use_default_rules: true

offline: false
