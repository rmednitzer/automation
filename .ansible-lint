---
profile: production

exclude_paths:
  - .git/
  - .github/
  - collections/
  - .venv/
  - venv/
  # ansible-vault-encrypted secrets files are named `vault.yml` (CLAUDE.md
  # "Secrets management") and can live at any documented vault path —
  # inventories/<env>/group_vars/vault.yml AND
  # inventories/<env>/host_vars/<host>/vault.yml — so match them with a glob
  # that mirrors the check-vault guard (any `vault.yml`). Their ciphertext is
  # not parseable YAML. The plaintext `vault.yml.example` templates do not
  # match `vault.yml` and keep being linted.
  - "**/vault.yml"

skip_list:
  - yaml[line-length]
  - var-naming[no-role-prefix]

enable_list:
  - fqcn
  - no-changed-when

warn_list:
  - experimental

use_default_rules: true

offline: false
